{
  "name": "Agentic Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "runArgs": ["--shm-size=2g"],
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24", "pnpmVersion": "none" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // NPM_REGISTRY is read by setup.sh, a lifecycle command. containerEnv is
  // applied at container creation so lifecycle commands definitely see it;
  // remoteEnv's propagation to them is version-dependent.
  "containerEnv": {
    "NPM_REGISTRY": "${localEnv:NPM_REGISTRY}",
    // Keep Claude's .claude.json inside the persisted ~/.claude volume.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  // Agent sign-ins, settings, and session history live in named volumes, one
  // set per project, so they survive "Rebuild Container". Remove them with
  // `docker volume rm` (see README) to start fresh.
  "mounts": [
    "source=agent-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=agent-codex-${devcontainerId},target=/home/vscode/.codex,type=volume",
    "source=agent-gemini-${devcontainerId},target=/home/vscode/.gemini,type=volume",
    "source=agent-gh-${devcontainerId},target=/home/vscode/.config/gh,type=volume"
  ],
  // Docker creates fresh volume mount points (and a missing ~/.config) owned
  // by root. Fix that in onCreateCommand, which finishes before VS Code
  // starts extensions; setup.sh runs later in postCreateCommand.
  "onCreateCommand": "for d in \"$HOME/.config\" \"$HOME/.config/gh\" \"$HOME/.claude\" \"$HOME/.codex\" \"$HOME/.gemini\"; do sudo mkdir -p \"$d\" && sudo chown \"$(id -u):$(id -g)\" \"$d\"; done",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-python.pylint"] }
  },
  "remoteUser": "vscode"
}
